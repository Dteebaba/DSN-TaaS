# Copy to .env (never commit .env). Values come from Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=public-anon-key
# Server-side only. Never put this in the frontend or in Vercel public env vars.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
MAIL_FROM="DSN Talent Platform <talent@example.org>"
